{
  "name": "@unownhash/rotom-base-ui",
  "version": "1.0.0",
  "description": "Shared dashboard components for the RotomNG web UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnownHash/RotomNG.git",
    "directory": "libs/base-ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
