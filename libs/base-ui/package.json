    "./*": "./src/*"
  },
  "peerDependencies": {
    "msw": "^2.14.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "dependencies": {
    "@number-flow/react": "^0.6.0",
    "@tanstack/react-query": "^5.100.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.39.0",
    "radix-ui": "^1.5.0",
    "react-router": "^8.3.0",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
