{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/rotom-ng-ui/**/*.{ts,tsx,js,jsx,json,jsonc}",
      "libs/base-ui/**/*.{ts,tsx,js,jsx,json,jsonc}",
      "!**/node_modules",
      "!**/dist",
      "!libs/rotom_ui/static",
      "!**/.vite",
      "!**/version.ts",
      "!**/mockServiceWorker.js",
      "!libs/base-ui/src/components/ui"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
