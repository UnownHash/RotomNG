{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../libs/base-ui/src/*"],
      "@rotom-ng/base-ui": ["../../libs/base-ui/src/index.ts"],
      "@rotom-ng/base-ui/*": ["../../libs/base-ui/src/*"]
    }
  },
  "files": [],
  "exclude": [
    "jest.config.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx"
  ],
  "include": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "src/vite-env.d.ts"]
}
